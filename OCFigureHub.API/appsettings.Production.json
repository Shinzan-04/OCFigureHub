{
  "ConnectionStrings": {
    "DefaultConnection": "#{ConnectionStrings__DefaultConnection}#"
  },
  "Jwt": {
    "Issuer": "OCFigureHub",
    "Audience": "OCFigureHubClient",
    "Key": "#{Jwt__Key}#",
    "ExpireMinutes": 1440
  },
  "AzureBlob": {
    "ConnectionString": "#{AzureBlob__ConnectionString}#",
    "ContainerName": "product-files",
    "SasExpireMinutes": 5
  },
  "PayOS": {
    "ClientId": "#{PayOS__ClientId}#",
    "ApiKey": "#{PayOS__ApiKey}#",
    "ChecksumKey": "#{PayOS__ChecksumKey}#",
    "BaseUrl": "https://api-merchant.payos.vn",
    "ReturnUrl": "#{PayOS__ReturnUrl}#",
    "CancelUrl": "#{PayOS__CancelUrl}#"
  },
  "VNPay": {
    "TmnCode": "#{VNPay__TmnCode}#",
    "HashSecret": "#{VNPay__HashSecret}#",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "#{VNPay__ReturnUrl}#",
    "IpnUrl": "#{VNPay__IpnUrl}#"
  },
  "Google": {
    "ClientId": "#{Google__ClientId}#",
    "ClientSecret": "#{Google__ClientSecret}#"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUser": "#{EmailSettings__SmtpUser}#",
    "SmtpPass": "#{EmailSettings__SmtpPass}#",
    "FromEmail": "#{EmailSettings__FromEmail}#"
  },
  "GeminiFree": {
    "ApiKey": "#{GeminiFree__ApiKey}#"
  },
  "GeminiCheap": {
    "ApiKey": "#{GeminiCheap__ApiKey}#"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
